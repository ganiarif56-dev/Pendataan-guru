{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Jalankan Server SD Salatiga 03",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/server/server.js",
      "restart": true,
      "serverReadyAction": {
        "pattern": "http://localhost:[0-9]+",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
